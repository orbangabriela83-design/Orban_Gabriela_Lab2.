@page
@model Orban_Gabriela_Lab2.Pages.Publishers.IndexModel
@{ViewData["Title"]="Publishers";}
<h1>Publishers</h1>
<p><a asp-page="./Create">Create New</a></p><div class="table-responsive"><table class="table"><thead><tr><th>PublisherName</th><th>Actions</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr class="@(Model.SelectedID == item.ID ? "table-success" : "")"><td>@item.PublisherName</td><td><a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> | <a asp-page="./Details" asp-route-id="@item.ID">Details</a> | <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a></td></tr>}</tbody></table></div>