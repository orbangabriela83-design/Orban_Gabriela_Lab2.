@page
@model Orban_Gabriela_Lab2.Pages.Books.DeleteModel
@{ViewData["Title"]="Delete Book";}
<h1>Delete Book</h1>
<p>Are you sure you want to delete this book?</p><div asp-validation-summary="All" class="text-danger"></div><dl class="row"><dt class="col-sm-3">Book Title</dt><dd class="col-sm-9">@Model.Item.Title</dd><dt class="col-sm-3">Author</dt><dd class="col-sm-9">@(Model.Item.Author?.FullName)</dd><dt class="col-sm-3">Price</dt><dd class="col-sm-9">@Model.Item.Price.ToString("F2")</dd><dt class="col-sm-3">Publishing Date</dt><dd class="col-sm-9">@Model.Item.PublishingDate.ToString("yyyy-MM-dd")</dd><dt class="col-sm-3">Publisher</dt><dd class="col-sm-9">@(Model.Item.Publisher?.PublisherName)</dd></dl><form method="post"><input type="hidden" asp-for="Item.ID"/><button class="btn btn-danger">Delete</button></form><p><a asp-page="./Index">Back to List</a></p>