@page
@model Orban_Gabriela_Lab2.Pages.Books.IndexModel
@{ViewData["Title"]="Books";}
<h1>Books</h1>
<p><a asp-page="./Create">Create New</a></p><form method="get" class="mb-3"><label for="authorID">Author</label><select name="authorID" id="authorID" asp-items="Model.Authors"><option value="">All authors</option></select><button class="btn btn-primary">Search</button> <a asp-page="./Index">Back to full list</a></form><div class="table-responsive"><table class="table"><thead><tr><th>Book Title</th><th>Author</th><th>Price</th><th>Publishing Date</th><th>Publisher</th><th>Actions</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr class="@(Model.SelectedID == item.ID ? "table-success" : "")"><td>@item.Title</td><td>@(item.Author?.FullName)</td><td>@item.Price.ToString("F2")</td><td>@item.PublishingDate.ToString("yyyy-MM-dd")</td><td>@(item.Publisher?.PublisherName)</td><td><a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> | <a asp-page="./Details" asp-route-id="@item.ID">Details</a> | <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a></td></tr>}</tbody></table></div>