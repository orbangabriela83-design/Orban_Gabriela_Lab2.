@page
@model Orban_Gabriela_Lab2.Pages.Books.EditModel
@{ViewData["Title"]="Edit Book";}
<h1>Edit Book</h1>
<form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input type="hidden" asp-for="Item.ID"/><div class="mb-3"><label asp-for="Item.Title" class="form-label"></label><input asp-for="Item.Title" type="text" class="form-control"/><span asp-validation-for="Item.Title" class="text-danger"></span></div><div class="mb-3"><label asp-for="Item.Price" class="form-label"></label><input asp-for="Item.Price" type="number" step="0.01" class="form-control"/><span asp-validation-for="Item.Price" class="text-danger"></span></div><div class="mb-3"><label asp-for="Item.PublishingDate" class="form-label"></label><input asp-for="Item.PublishingDate" type="date" class="form-control"/><span asp-validation-for="Item.PublishingDate" class="text-danger"></span></div><div class="mb-3"><label asp-for="Item.AuthorID" class="form-label"></label><select asp-for="Item.AuthorID" asp-items="Model.AuthorIDList" class="form-select"><option value="">-- Select --</option></select><span asp-validation-for="Item.AuthorID" class="text-danger"></span></div><div class="mb-3"><label asp-for="Item.PublisherID" class="form-label"></label><select asp-for="Item.PublisherID" asp-items="Model.PublisherIDList" class="form-select"><option value="">-- Select --</option></select><span asp-validation-for="Item.PublisherID" class="text-danger"></span></div><button class="btn btn-primary">Save</button></form><p><a asp-page="./Index">Back to List</a></p>
@section Scripts {<partial name="_ValidationScriptsPartial"/>}